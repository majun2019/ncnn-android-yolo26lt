{
  // Markdown structure rules for the Chinese manuscript baseline.
  "default": true,

  // The current draft contains references, formulas, and long technical lines.
  "MD013": false,
  "MD033": false,
  "MD034": false,
  "MD036": false,
  // Some files start with a comment or description line rather than H1.
  "MD041": false,

  "MD003": {
    "style": "atx"
  },
  "MD004": {
    "style": "dash"
  },
  "MD007": {
    "indent": 4
  },
  "MD025": {
    "level": 1
  },
  "MD029": {
    "style": "ordered"
  },
  "MD046": {
    "style": "fenced"
  },
  "MD048": {
    "style": "backtick"
  },
  "MD049": {
    "style": "asterisk"
  },
  "MD050": {
    "style": "asterisk"
  }
}